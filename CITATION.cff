cff-version: 1.2.0
message: "If you use StrumKANet in academic work, please cite the IEEE IS2 2025 paper (preferred-citation) and, when you use the data, the Strummin' Dataset."
title: "StrumKANet: A Kolmogorov-Arnold NAS Framework for Strumming Pattern Recognition"
type: software
license: CC-BY-4.0
repository-code: "https://github.com/StefanoGiacomelli/StrumKANet"
url: "https://github.com/StefanoGiacomelli/StrumKANet"
keywords:
  - strumming pattern recognition
  - rhythm descriptors
  - Kolmogorov-Arnold networks
  - wavelet KAN
  - neural architecture search
  - music information retrieval
authors:
  - family-names: Pennese
    given-names: Marco
  - family-names: Giacomelli
    given-names: Stefano
